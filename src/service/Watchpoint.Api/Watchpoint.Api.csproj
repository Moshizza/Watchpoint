<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Watchpoint.Api</RootNamespace>
    <Description>REST framework (pipeline, problem details, paging, ETags, idempotency, permission filter, OpenAPI) and system endpoints (spec API §4–§7).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Watchpoint.Kernel/Watchpoint.Kernel.csproj" />
    <ProjectReference Include="../Watchpoint.Hosting/Watchpoint.Hosting.csproj" />
    <ProjectReference Include="../Watchpoint.Identity/Watchpoint.Identity.csproj" />
    <ProjectReference Include="../Watchpoint.Secrets/Watchpoint.Secrets.csproj" />
    <ProjectReference Include="../Watchpoint.Storage/Watchpoint.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Watchpoint.Api.Tests" />
    <InternalsVisibleTo Include="Watchpoint.IntegrationTests" />
  </ItemGroup>

</Project>
