<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code fixes for Watchpoint.Analyzers (Architecture/specs/TST-test-infrastructure.md §7). Separate assembly because
    code fixes need Microsoft.CodeAnalysis.Workspaces, which the command-line compiler does not load (RS1038).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Watchpoint.Analyzers</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Watchpoint.Analyzers/Watchpoint.Analyzers.csproj" />
  </ItemGroup>

</Project>
