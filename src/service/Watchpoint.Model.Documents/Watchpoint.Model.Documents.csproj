<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Watchpoint.Model.Documents</RootNamespace>
    <Description>Watchpoint document models, schema validation, and reader.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Watchpoint.Kernel/Watchpoint.Kernel.csproj" />
  </ItemGroup>

  <!-- The schema files of the repository root, embedded for DocumentReader.FromEmbeddedSchemas (wptypes, runtime). -->
  <ItemGroup>
    <EmbeddedResource Include="../../../schemas/*.schema.json" LogicalName="schemas/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Watchpoint.Model.Documents.Tests" />
  </ItemGroup>

</Project>
