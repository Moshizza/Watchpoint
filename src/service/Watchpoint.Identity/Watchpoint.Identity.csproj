    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Watchpoint.Kernel/Watchpoint.Kernel.csproj" />
    <ProjectReference Include="../Watchpoint.Storage/Watchpoint.Storage.csproj" />
    <ProjectReference Include="../Watchpoint.Secrets/Watchpoint.Secrets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Internal/Passwords/breached-passwords-100k.txt.gz" LogicalName="Watchpoint.Identity.Internal.Passwords.breached-passwords-100k.txt.gz" />
