<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Watchpoint.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Watchpoint.Hosting/Watchpoint.Hosting.csproj" />
    <ProjectReference Include="../Watchpoint.Storage/Watchpoint.Storage.csproj" />
    <ProjectReference Include="../Watchpoint.Storage.Postgres/Watchpoint.Storage.Postgres.csproj" />
    <ProjectReference Include="../Watchpoint.Identity/Watchpoint.Identity.csproj" />
    <ProjectReference Include="../Watchpoint.Model/Watchpoint.Model.csproj" />
    <ProjectReference Include="../Watchpoint.Integrations/Watchpoint.Integrations.csproj" />
    <ProjectReference Include="../Watchpoint.Secrets/Watchpoint.Secrets.csproj" />
