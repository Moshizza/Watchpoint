<Project Sdk="Microsoft.NET.Sdk">

  <!-- Connector conformance suite and test helpers (Architecture/specs/INT-integration-contract.md §12). -->
  <PropertyGroup>
    <RootNamespace>Watchpoint.Integration.Testing</RootNamespace>
    <Description>Connector conformance suite and fake connector host for Watchpoint connectors.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Watchpoint.Integration.Abstractions/Watchpoint.Integration.Abstractions.csproj" />
    <ProjectReference Include="../Watchpoint.Integration.Sdk/Watchpoint.Integration.Sdk.csproj" />
    <ProjectReference Include="../../service/Watchpoint.Kernel.Testing/Watchpoint.Kernel.Testing.csproj" />
  </ItemGroup>

</Project>
