{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["host", "mappings"],
  "properties": {
    "host": { "type": "string" },
    "port": { "type": "integer", "default": 1883 },
    "protocolVersion": { "type": "string", "enum": ["5.0", "3.1.1", "3.1"], "default": "5.0" },
    "allowPlain": { "type": "boolean", "default": false },
    "clientId": { "type": "string" },
    "cleanSession": { "type": "boolean", "default": true },
    "keepAlive": { "type": "string", "default": "PT30S" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "topic"],
        "properties": {
          "id": { "type": "string" },
          "topic": { "type": "string" }
        }
      }
    }
  }
}
