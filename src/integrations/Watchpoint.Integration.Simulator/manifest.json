{
  "$schema": "https://schemas.watchpoint.dev/manifest/1.json",
  "id": "watchpoint.integration.simulator",
  "version": "1.0.0",
  "vendor": "Watchpoint",
  "category": "generic",
  "contract": "^1.0",
  "minWatchpointVersion": "1.0.0",
  "platforms": ["win-x64", "linux-x64"],
  "nativeCode": false,
  "isolation": "inProcessAllowed",
  "licence": {
    "class": "included"
  },
  "connectors": [
    {
      "class": "Watchpoint.Integration.Simulator::Watchpoint.Integration.Simulator.SimulatorConnector",
      "serverType": "sim.server",
      "supportedVendorVersions": "*",
      "features": [
        "discovery",
        "stateRefresh",
        "commandExecution",
        "eventCatchUp",
        "diagnostics"
      ],
      "settingsSchema": "settings/simulator.settings.json",
      "secretsSchema": {
        "fields": [
          {
            "id": "token",
            "kind": "token",
            "required": false
          }
        ]
      }
    }
  ],
  "types": [
    "types/sim.server.json"
  ],
  "capabilities": [],
  "ruleTemplates": [],
  "i18n": "i18n/",
  "docs": "docs/",
  "files": []
}
