{
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "embedded",
        "remote"
      ],
      "default": "embedded"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "default": "ws://localhost:5090/sim"
    },
    "profile": {
      "type": "string",
      "enum": [
        "office",
        "bank",
        "campus",
        "custom"
      ],
      "default": "office"
    },
    "doors": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000,
      "default": 20
    },
    "readersPerDoor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "default": 1
    },
    "areas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 2
    },
    "zonesPerArea": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200,
      "default": 5
    },
    "inputs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000,
      "default": 4
    },
    "outputs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000,
      "default": 4
    },
    "analogs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000,
      "default": 2
    },
    "seed": {
      "type": "integer",
      "default": 1
    },
    "activity": {
      "type": "string",
      "enum": [
        "calm",
        "normal",
        "busy",
        "stress"
      ],
      "default": "normal"
    },
    "commandLatency": {
      "type": "string",
      "default": "PT0.2S"
    },
    "failures": {
      "type": "array",
      "default": []
    },
    "scenario": {
      "type": "string",
      "default": ""
    },
    "timeZone": {
      "type": "string",
      "default": "Europe/Paris"
    },
    "token": {
      "type": "string"
    }
  }
}
