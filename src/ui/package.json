{
  "name": "@watchpoint/ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tooling of the UI workspace: TypeScript, ESLint, Prettier, Vitest, Tailwind preset (spec UIC §3).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-watchpoint": "workspace:*",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
