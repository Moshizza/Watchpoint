# Normalise line endings in the repository; check out with native endings except where noted.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.slnx    text
*.props   text
*.targets text
*.json    text
*.md      text diff=markdown
*.ts      text
*.tsx     text
*.yml     text
*.yaml    text

# Scripts that must keep their line endings on every platform
*.sh      text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary files
*.png     binary
*.jpg     binary
*.ico     binary
*.pdf     binary
*.wpkg    binary
*.zip     binary
*.woff2   binary
