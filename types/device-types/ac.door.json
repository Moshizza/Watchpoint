{
  "$schema": "https://schemas.watchpoint.dev/device-type/1.json",
  "id": "ac.door",
  "version": "1.0.0",
  "role": "device",
  "category": "accessControl",
  "extends": null,
  "capabilities": [
    {
      "id": "health",
      "version": "^1.0"
    },
    {
      "id": "doorPosition",
      "version": "^1.0"
    },
    {
      "id": "lockable",
      "version": "^1.0"
    },
    {
      "id": "openable",
      "version": "^1.0"
    },
    {
      "id": "doorMode",
      "version": "^1.0"
    },
    {
      "id": "accessEvents",
      "version": "^1.0"
    },
    {
      "id": "tamper",
      "version": "^1.0",
      "optional": true
    }
  ],
  "attributes": {
    "type": "object",
    "properties": {
      "heldOpenAfter": {
        "type": "duration",
        "default": "PT60S",
        "minimum": "PT5S",
        "maximum": "PT1H"
      }
    }
  },
  "allowedChildTypes": [
    "ac.reader",
    "generic.binary-input",
    "generic.binary-output"
  ],
  "licenceClass": "full",
  "display": {
    "icon": "door-closed",
    "symbol": "ac.door",
    "primaryProperty": "doorPosition.position"
  },
  "stateSummary": {
    "overrides": [
      {
        "property": "lockable.lockState",
        "values": [
          "unlocked"
        ],
        "state": "normalActive"
      }
    ]
  },
  "defaultAlarmRules": [
    "std.ac.door.forced",
    "std.ac.door.heldOpen",
    "std.health.offline"
  ],
  "defaultLinks": [
    {
      "kind": "cameraViews",
      "peerCategory": "video"
    }
  ]
}
