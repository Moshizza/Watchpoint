{
  "$schema": "https://schemas.watchpoint.dev/device-type/1.json",
  "id": "generic.binary-input",
  "version": "1.0.0",
  "role": "device",
  "category": "generic",
  "extends": null,
  "capabilities": [
    {
      "id": "health",
      "version": "^1.0"
    },
    {
      "id": "binaryValue",
      "version": "^1.0"
    }
  ],
  "attributes": {
    "type": "object",
    "properties": {
      "trueSeverity": {
        "type": "string",
        "enum": [
          "normal",
          "normalActive",
          "info",
          "warning",
          "alarm",
          "fault",
          "offline",
          "unknown"
        ],
        "default": "normalActive"
      },
      "falseSeverity": {
        "type": "string",
        "enum": [
          "normal",
          "normalActive",
          "info",
          "warning",
          "alarm",
          "fault",
          "offline",
          "unknown"
        ],
        "default": "normal"
      },
      "trueLabel": {
        "type": "string",
        "maxLength": 100
      },
      "falseLabel": {
        "type": "string",
        "maxLength": 100
      }
    }
  },
  "licenceClass": "light",
  "display": {
    "icon": "toggle-left",
    "symbol": "generic.binary-input",
    "primaryProperty": "binaryValue.value"
  }
}
