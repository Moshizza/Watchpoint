{
  "$schema": "https://schemas.watchpoint.dev/device-type/1.json",
  "id": "generic.analog-input",
  "version": "1.0.0",
  "role": "device",
  "category": "generic",
  "extends": null,
  "capabilities": [
    {
      "id": "health",
      "version": "^1.0"
    },
    {
      "id": "measurement",
      "version": "^1.0"
    }
  ],
  "attributes": {
    "type": "object",
    "properties": {
      "unit": {
        "type": "string",
        "maxLength": 32
      },
      "min": {
        "type": "number"
      },
      "max": {
        "type": "number"
      },
      "warningAbove": {
        "type": "number"
      },
      "alarmAbove": {
        "type": "number"
      },
      "warningBelow": {
        "type": "number"
      },
      "alarmBelow": {
        "type": "number"
      },
      "hysteresis": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "licenceClass": "light",
  "display": {
    "icon": "gauge",
    "symbol": "generic.analog-input",
    "primaryProperty": "measurement.value"
  }
}
