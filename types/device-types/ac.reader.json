{
  "$schema": "https://schemas.watchpoint.dev/device-type/1.json",
  "id": "ac.reader",
  "version": "1.0.0",
  "role": "device",
  "category": "accessControl",
  "extends": null,
  "capabilities": [
    {
      "id": "health",
      "version": "^1.0"
    },
    {
      "id": "accessEvents",
      "version": "^1.0"
    },
    {
      "id": "tamper",
      "version": "^1.0",
      "optional": true
    }
  ],
  "licenceClass": "free",
  "display": {
    "icon": "scan-line",
    "symbol": "ac.reader",
    "primaryProperty": "health.connectivity"
  },
  "defaultAlarmRules": [
    "std.health.offline"
  ]
}
