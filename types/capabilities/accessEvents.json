{
  "$schema": "https://schemas.watchpoint.dev/capability/1.json",
  "id": "accessEvents",
  "version": "1.0.0",
  "properties": [
    {
      "id": "lastAccess",
      "valueType": "object",
      "history": {
        "mode": "everyChange"
      },
      "objectSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          },
          "credentialRef": {
            "type": "string"
          },
          "holderRef": {
            "type": "string"
          },
          "holderName": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "commands": [],
  "events": [
    {
      "id": "granted",
      "severity": "info",
      "payload": {
        "type": "object",
        "properties": {
          "credentialRef": {
            "type": "string"
          },
          "holderRef": {
            "type": "string"
          },
          "holderName": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          }
        }
      },
      "personalData": [
        "holderName"
      ]
    },
    {
      "id": "denied",
      "severity": "warning",
      "payload": {
        "type": "object",
        "properties": {
          "credentialRef": {
            "type": "string"
          },
          "holderRef": {
            "type": "string"
          },
          "holderName": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "noRights",
              "outsideSchedule",
              "expired",
              "blocked",
              "unknownCredential",
              "antipassback",
              "other"
            ]
          }
        }
      },
      "personalData": [
        "holderName"
      ]
    },
    {
      "id": "duress",
      "severity": "alarm",
      "payload": {
        "type": "object",
        "properties": {}
      }
    }
  ]
}
