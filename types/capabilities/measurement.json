{
  "$schema": "https://schemas.watchpoint.dev/capability/1.json",
  "id": "measurement",
  "version": "1.0.0",
  "properties": [
    {
      "id": "value",
      "valueType": "decimal",
      "decimals": 2,
      "history": {
        "mode": "deadband",
        "type": "percent",
        "threshold": 1
      }
    }
  ],
  "commands": [],
  "events": [
    {
      "id": "thresholdCrossed",
      "severity": "warning",
      "payload": {
        "type": "object",
        "properties": {
          "threshold": {
            "type": "string",
            "enum": [
              "warningAbove",
              "alarmAbove",
              "warningBelow",
              "alarmBelow",
              "normal"
            ]
          },
          "value": {
            "type": "number"
          }
        }
      }
    }
  ]
}
