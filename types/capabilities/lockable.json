{
  "$schema": "https://schemas.watchpoint.dev/capability/1.json",
  "id": "lockable",
  "version": "1.0.0",
  "properties": [
    {
      "id": "lockState",
      "valueType": "enum",
      "enumValues": [
        {
          "code": "locked",
          "severity": "normal"
        },
        {
          "code": "unlocked",
          "severity": "normalActive"
        },
        {
          "code": "unknown",
          "severity": "unknown"
        }
      ],
      "history": {
        "mode": "everyChange"
      }
    }
  ],
  "commands": [
    {
      "id": "lock",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "risk": "sensitive",
      "timeout": "PT30S",
      "expectedEffect": {
        "property": "lockable.lockState",
        "equals": "locked",
        "within": "PT10S"
      }
    },
    {
      "id": "unlock",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "risk": "sensitive",
      "timeout": "PT30S",
      "expectedEffect": {
        "property": "lockable.lockState",
        "equals": "unlocked",
        "within": "PT10S"
      }
    }
  ],
  "events": []
}
