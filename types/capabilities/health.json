{
  "$schema": "https://schemas.watchpoint.dev/capability/1.json",
  "id": "health",
  "version": "1.0.0",
  "properties": [
    {
      "id": "connectivity",
      "valueType": "enum",
      "enumValues": [
        {
          "code": "online",
          "severity": "normal"
        },
        {
          "code": "degraded",
          "severity": "warning"
        },
        {
          "code": "offline",
          "severity": "offline"
        },
        {
          "code": "unknown",
          "severity": "unknown"
        }
      ],
      "history": {
        "mode": "everyChange"
      }
    },
    {
      "id": "faults",
      "valueType": "list",
      "itemType": "enum",
      "enumValues": [
        {
          "code": "tamper",
          "severity": "fault"
        },
        {
          "code": "batteryLow",
          "severity": "fault"
        },
        {
          "code": "powerFail",
          "severity": "fault"
        },
        {
          "code": "commFail",
          "severity": "fault"
        },
        {
          "code": "hardwareFault",
          "severity": "fault"
        },
        {
          "code": "configError",
          "severity": "fault"
        },
        {
          "code": "clockDrift",
          "severity": "fault"
        },
        {
          "code": "flooding",
          "severity": "fault"
        }
      ],
      "history": {
        "mode": "everyChange"
      }
    },
    {
      "id": "lastContact",
      "valueType": "timestamp",
      "history": {
        "mode": "none"
      }
    }
  ],
  "commands": [
    {
      "id": "refresh",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "risk": "normal",
      "timeout": "PT30S",
      "idempotent": true
    }
  ],
  "events": [
    {
      "id": "wentOffline",
      "severity": "fault",
      "payload": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "id": "cameOnline",
      "severity": "info",
      "payload": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "id": "faultRaised",
      "severity": "fault",
      "payload": {
        "type": "object",
        "properties": {
          "fault": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "faultCleared",
      "severity": "info",
      "payload": {
        "type": "object",
        "properties": {
          "fault": {
            "type": "string"
          }
        }
      }
    }
  ]
}
