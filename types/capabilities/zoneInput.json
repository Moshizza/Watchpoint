{
  "$schema": "https://schemas.watchpoint.dev/capability/1.json",
  "id": "zoneInput",
  "version": "1.0.0",
  "properties": [
    {
      "id": "state",
      "valueType": "enum",
      "enumValues": [
        {
          "code": "normal",
          "severity": "normal"
        },
        {
          "code": "active",
          "severity": "alarm"
        },
        {
          "code": "tamper",
          "severity": "alarm"
        },
        {
          "code": "short",
          "severity": "fault"
        },
        {
          "code": "openCircuit",
          "severity": "fault"
        },
        {
          "code": "masked",
          "severity": "fault"
        },
        {
          "code": "fault",
          "severity": "fault"
        }
      ],
      "history": {
        "mode": "everyChange"
      }
    }
  ],
  "commands": [],
  "events": [
    {
      "id": "activated",
      "severity": "alarm",
      "payload": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "id": "restored",
      "severity": "info",
      "payload": {
        "type": "object",
        "properties": {}
      }
    }
  ]
}
