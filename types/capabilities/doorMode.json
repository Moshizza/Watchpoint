{
  "$schema": "https://schemas.watchpoint.dev/capability/1.json",
  "id": "doorMode",
  "version": "1.0.0",
  "properties": [
    {
      "id": "mode",
      "valueType": "enum",
      "enumValues": [
        {
          "code": "normal",
          "severity": "normal"
        },
        {
          "code": "unlocked",
          "severity": "normalActive"
        },
        {
          "code": "lockedDown",
          "severity": "warning"
        },
        {
          "code": "emergencyOpen",
          "severity": "alarm"
        },
        {
          "code": "emergencyClose",
          "severity": "alarm"
        }
      ],
      "history": {
        "mode": "everyChange"
      }
    }
  ],
  "commands": [
    {
      "id": "setMode",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "normal",
              "unlocked",
              "lockedDown",
              "emergencyOpen",
              "emergencyClose"
            ]
          },
          "until": {
            "type": "timestamp"
          }
        },
        "required": [
          "mode"
        ]
      },
      "risk": "sensitive",
      "timeout": "PT30S",
      "riskByArgument": {
        "mode": {
          "lockedDown": "critical",
          "emergencyOpen": "critical",
          "emergencyClose": "critical"
        }
      }
    }
  ],
  "events": [
    {
      "id": "modeChanged",
      "severity": "info",
      "payload": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    }
  ]
}
