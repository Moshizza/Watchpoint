# Pinned versions of bundled and development infrastructure (Architecture/README.md §4).
# Upgrades are tasks of their own: change the pins here, in deploy/dev/compose.yml and in the test fixtures
# (ContainerImages, NatsServerBinary) together; test HST-I-010 fails when they differ.

# NATS server (Apache-2.0). Release archives: https://github.com/nats-io/nats-server/releases, SHA-256 from SHA256SUMS.
NATS_SERVER_VERSION=2.15.2
NATS_SERVER_SHA256_LINUX_AMD64=67cb8e10bc6f0c4b47f75a728529a20953dbae2a4f9a4a52ae8517d65ae303ff
NATS_SERVER_SHA256_LINUX_ARM64=bc2c788dcbf2849af749564e06a0d48c19bced851f2d68a2e21c54d078949b28
NATS_SERVER_SHA256_WINDOWS_AMD64=f6398d5d11093778f870db70242cb50d20a58134c937c805ba8d114e7e398766
NATS_SERVER_SHA256_WINDOWS_ARM64=0c688b55a074b48289b84edc8b68936421c00cef7bb5ae589ef48e5f8e6a161d
NATS_SERVER_SHA256_DARWIN_AMD64=9c45b23c19498692e81cd39c75e8382f0e6ff59c0d5b9470e32fe6640afa4446
NATS_SERVER_SHA256_DARWIN_ARM64=cbd2219d01502c38733485ac684269da585ee479fa3b1377264beecdefdf9e9d

