<!--
  Shared build settings for every .NET project in the repository (src/, tests/, tools/).
  See Architecture/README.md §5.1. Placed at the repository root so that test and tool
  projects outside src/service inherit the same settings.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Quality gates -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required by IDE0005 (unnecessary usings) to run during build; CS1591 is silenced in .editorconfig. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Reproducible builds and source link -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>

    <!-- Product information -->
    <Company>Watchpoint</Company>
    <Product>Watchpoint</Product>
    <Copyright>Copyright © Watchpoint. All rights reserved.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;fr;ar</SatelliteResourceLanguages>

    <!-- Restore -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Contract projects (public surface) must document their public members. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Abstractions')) Or '$(MSBuildProjectName)' == 'Watchpoint.Kernel'">
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Watchpoint analyzers (Architecture/specs/TST-test-infrastructure.md §7) on every project under src/ and tests/.
    WatchpointTestCode=true marks test code (projects under tests/): WP0005 applies there, WP0003 does not.
    A project may set WatchpointUseAnalyzers=false (the analyzer projects and their tests do).
  -->
  <PropertyGroup>
    <_WpRelativeDir>$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectDirectory)).Replace('\', '/'))</_WpRelativeDir>
    <WatchpointTestCode Condition="'$(WatchpointTestCode)' == '' And $(_WpRelativeDir.StartsWith('tests/'))">true</WatchpointTestCode>
    <WatchpointUseAnalyzers Condition="'$(WatchpointUseAnalyzers)' == '' And ($(_WpRelativeDir.StartsWith('src/')) Or $(_WpRelativeDir.StartsWith('tests/'))) And !$(MSBuildProjectName.StartsWith('Watchpoint.Analyzers'))">true</WatchpointUseAnalyzers>
  </PropertyGroup>

  <!-- Test projects are never packed or published. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup Condition="'$(WatchpointUseAnalyzers)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/service/Watchpoint.Analyzers/Watchpoint.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/service/Watchpoint.Analyzers.CodeFixes/Watchpoint.Analyzers.CodeFixes.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <CompilerVisibleProperty Include="WatchpointTestCode" />
  </ItemGroup>
</Project>
