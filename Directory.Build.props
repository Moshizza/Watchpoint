<!--
  Shared build settings for every .NET project in the repository (src/, tests/, tools/).
  See Architecture/README.md §5.1. Placed at the repository root so that test and tool
  projects outside src/service inherit the same settings.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Quality gates -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required by IDE0005 (unnecessary usings) to run during build; CS1591 is silenced in .editorconfig. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Reproducible builds and source link -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>

    <!-- Product information -->
    <Company>Watchpoint</Company>
    <Product>Watchpoint</Product>
    <Copyright>Copyright © Watchpoint. All rights reserved.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;fr;ar</SatelliteResourceLanguages>

    <!-- Restore -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Contract projects (public surface) must document their public members. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Abstractions')) Or '$(MSBuildProjectName)' == 'Watchpoint.Kernel'">
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!-- Test projects are never packed or published. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
</Project>
