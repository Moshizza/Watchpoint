{
  "$schema": "https://schemas.watchpoint.dev/capability/1.json",
  "id": "gadget",
  "version": "1.2.0",
  "properties": [
    { "id": "mode", "valueType": "enum", "enumValues": [{ "code": "idle", "severity": "normal" }, { "code": "busy", "severity": "normalActive" }] },
    { "id": "level", "valueType": "decimal", "unit": "%", "range": { "min": 0, "max": 100 } },
    { "id": "jammed", "valueType": "boolean", "booleanSeverity": { "true": "fault", "false": "normal" } }
  ],
  "commands": [
    { "id": "start", "risk": "sensitive", "parameters": { "type": "object", "properties": { "speed": { "type": "integer", "minimum": 1, "maximum": 10 }, "label": { "type": "string" } }, "required": ["speed"] } }
  ],
  "events": [
    { "id": "jam", "severity": "fault", "payload": { "type": "object", "properties": { "at": { "type": "timestamp" } } } }
  ]
}
