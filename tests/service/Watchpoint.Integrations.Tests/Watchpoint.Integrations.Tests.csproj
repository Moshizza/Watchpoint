<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of the integration runtime, package side (IRT-U-001…025). Test packages are built at test time by
       Watchpoint.Integrations.Testing (Roslyn-compiled connectors, manifests signed with a test Ed25519 key). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Watchpoint.Integrations.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/service/Watchpoint.Kernel/Watchpoint.Kernel.csproj" />
    <ProjectReference Include="../../../src/service/Watchpoint.Model.Documents/Watchpoint.Model.Documents.csproj" />
    <ProjectReference Include="../../../src/service/Watchpoint.Model/Watchpoint.Model.csproj" />
    <ProjectReference Include="../../../src/service/Watchpoint.Integrations/Watchpoint.Integrations.csproj" />
    <ProjectReference Include="../../../src/integrations/Watchpoint.Integration.Abstractions/Watchpoint.Integration.Abstractions.csproj" />
    <ProjectReference Include="../../../src/integrations/Watchpoint.Integration.Sdk/Watchpoint.Integration.Sdk.csproj" />
    <ProjectReference Include="../Watchpoint.Integrations.Testing/Watchpoint.Integrations.Testing.csproj" />
    <ProjectReference Include="../Watchpoint.Testing/Watchpoint.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
