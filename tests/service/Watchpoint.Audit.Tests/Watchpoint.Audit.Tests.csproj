<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of the audit trail (spec AUD §14): canonical form, hash chain, writer, verifier, query, export and DI, on an in-memory store. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Watchpoint.Audit.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/service/Watchpoint.Audit/Watchpoint.Audit.csproj" />
    <ProjectReference Include="../Watchpoint.Testing/Watchpoint.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../vectors/audit/*.json" LinkBase="vectors/audit" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
