<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builders of test packages for the integration runtime tests (unit and integration): connector assemblies
       compiled with Roslyn, manifests with file hashes signed with a test Ed25519 key, the simulator package staged
       from its build output. Two versions of a real NuGet library (Humanizer.Core) are downloaded for IRT-I-004. -->
  <PropertyGroup>
    <RootNamespace>Watchpoint.Integrations.Testing</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="NSec.Cryptography" />
    <PackageDownload Include="Humanizer.Core" Version="[2.14.1];[3.0.1]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/service/Watchpoint.Kernel/Watchpoint.Kernel.csproj" />
    <ProjectReference Include="../../../src/service/Watchpoint.Model.Documents/Watchpoint.Model.Documents.csproj" />
    <ProjectReference Include="../../../src/integrations/Watchpoint.Integration.Abstractions/Watchpoint.Integration.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)humanizer.core/2.14.1/lib/netstandard2.0/Humanizer.dll" Link="nuget-libraries/Humanizer-2.14.1.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)humanizer.core/3.0.1/lib/net10.0/Humanizer.dll" Link="nuget-libraries/Humanizer-3.0.1.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
