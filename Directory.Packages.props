<!--
  Central package versions for every .NET project (Architecture/README.md §4).
  Projects reference packages without a version: <PackageReference Include="Name" />.
  Adding or upgrading a package is reviewed like code; versions are exact (no ranges).
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Package versions are added by the tasks that first need them (T0.03 onwards). -->
  <ItemGroup>
    <!-- Logging -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <!-- Data and messaging -->
    <PackageVersion Include="NATS.Net" Version="3.3.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Tests -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.Nats" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!--
    Roslyn: Watchpoint.Analyzers compiles against an older Roslyn so that every supported compiler and IDE
    can load it (an analyzer built against a newer Roslyn than the compiler fails with CS8032);
    test projects use the latest.
  -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('Watchpoint.Analyzers')) And !$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup Condition="!$(MSBuildProjectName.StartsWith('Watchpoint.Analyzers')) Or $(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>
</Project>
